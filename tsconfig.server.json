{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "src/app/api/**/*.ts",
    "tests/**/*.ts",
    "src/types/domain.ts",
    "src/lib/validation.ts",
    "src/lib/formResolver.ts",
    "src/lib/pricing.ts",
    "src/mocks/hotelsFixtureCatalog.ts",
    "src/services/providers/types.ts",
    "src/services/gateway/embeddedGatewayCore.ts"
  ]
}
