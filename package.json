  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --env-file=.env --test tests/*.test.ts && functions/venv/bin/python -m unittest discover -s functions/tests -p \"test_*.py\"",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:functions": "functions/venv/bin/python -m unittest discover -s functions/tests -p \"test_*.py\"",
    "test:emulators": "npx --yes --package firebase-tools firebase emulators:exec --project demo-gowild --only auth,firestore,functions \"functions/venv/bin/python functions/tests/emulator_check.py\"",
    "firebase:emulators": "npx --yes --package firebase-tools firebase emulators:start --project demo-gowild --only auth,firestore,functions",
    "firebase:test-connection": "node --env-file=.env scripts/verify-connection.mjs"
  },
  "private": true
