{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "functions": {
      "port": 5001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "gowild",
      "runtime": "python312",
      "ignore": [
        "venv",
        "venv/**",
        ".venv",
        "__pycache__",
        "**/__pycache__/**",
        "**/*.pyc",
        "tests",
        "*.local",
        ".secret.*",
        ".env*",
        "!.env.example"
      ]
    }
  ]
}
