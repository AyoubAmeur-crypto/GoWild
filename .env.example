# Nuitee Connect Hosted White-Label Booking Website (HTTPS trusted domain)
EXPO_PUBLIC_NUITEE_BOOKING_URL=https://ayoub-ameur-7p9zu.nuitee.link
EXPO_PUBLIC_LITEAPI_KEY=sand_your_sandbox_key_here

# PUBLIC Expo/Firebase configuration only. Supplier secrets belong in Secret Manager.
# Copy to .env and restart Expo after changing these build-time values.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=gowild-d3b29.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=gowild-d3b29
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=gowild-d3b29.firebasestorage.app
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Choose the independently deployed sandbox callable: liteapi or duffel.
EXPO_PUBLIC_HOTEL_PROVIDER=liteapi
# Development builds only; release builds always use hosted Firebase services.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Existing native build configuration (public identifiers/restricted Maps key).
# Google Sign-In plugin reads REVERSED_CLIENT_ID from GoogleService-Info.plist.
GOOGLE_MAPS_ANDROID_API_KEY=
