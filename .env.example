# ============================================================================
# goWild Environment Configuration (.env.example)
# Copy to .env — NEVER commit real secrets or place API keys in EXPO_PUBLIC_*
# ============================================================================

# --- Client-Safe Public Config (bundled into Expo app) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:4010
EXPO_PUBLIC_DEFAULT_CURRENCY=USD

# --- Secure BFF Server Config (server/ ONLY — never bundled into mobile) ---
NODE_ENV=development
PORT=4010
SQLITE_DB_PATH=./server/data/gowild.sqlite

# Active hotel inventory provider:
#   liteapi              -> LiteAPI v3.0 (https://dashboard.liteapi.travel)
#   duffel               -> Duffel Stays API v2 (https://app.duffel.com)
#   development_fixtures -> Explicit non-production fixture catalog (blocked when NODE_ENV=production)
GOWILD_PROVIDER=development_fixtures

# LiteAPI v3.0 Credentials (Server-side only)
LITEAPI_KEY=
LITEAPI_DATA_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_BOOK_BASE_URL=https://book.liteapi.travel/v3.0
LITEAPI_CHECKOUT_RETURN_URL=gowild://booking/confirmation

# Duffel Stays API v2 Credentials (Server-side only)
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

